# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# Env & secrets
.env
.env.*
.env.local
# Negations must come last — gitignore takes the final matching rule.
!.env.example
# Publishable client config, committed on purpose. Every value in it is
# EXPO_PUBLIC_* and already inlined into the bundle every visitor downloads.
!.env.production

# VS Code Local History snapshots every edit, including .env files, under
# timestamped names that the patterns above do not match. Never commit these.
.history/

# OS / editor
.DS_Store
.idea/
.vscode/

# Data
scripts/.cache/
