# Supabase project -> Settings -> API.
# Must be a syntactically valid URL even before you fill in the real project:
# expo's static web render executes lib/auth.ts at build time.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# A physical phone cannot reach `localhost` — use the laptop's LAN IP and make
# sure the phone is on the same Wi-Fi. Find it with: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Where the privacy policy lives for native builds. The web build ships the page
# itself at /privacy.html and ignores this.
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy.html

# Where the password-reset link should land for native builds. The web build
# uses its own origin. Whatever you set must also be listed in Supabase under
# Authentication -> URL Configuration -> Redirect URLs, or the link is refused.
EXPO_PUBLIC_RESET_URL=https://your-domain.example/reset-password
