# Local dev database (docker-compose service `db`)
DATABASE_URL=postgresql+psycopg://gym:gym@localhost:5432/gym

# Supabase project URL — Settings -> Data API -> Project URL.
# Access tokens are verified against the public keys this project publishes at
# <url>/auth/v1/.well-known/jwks.json. There is no shared secret to leak.
SUPABASE_URL=https://your-project-ref.supabase.co

# Photos (§9). Leave blank and the photo endpoints return a clear 503 while
# the rest of the app works normally. The bucket must have BlockPublicAccess
# fully on — the app reaches it only through short-lived presigned URLs.
# Credentials come from the standard AWS chain (env, profile, or task role).
S3_BUCKET=
AWS_REGION=

# Comma-separated; only needed if a web build is ever served
ALLOWED_ORIGINS=
