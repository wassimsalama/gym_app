# Local dev database (docker-compose service `db`)
DATABASE_URL=postgresql+psycopg://gym:gym@localhost:5432/gym

# Supabase project URL — Settings -> Data API -> Project URL.
# Access tokens are verified against the public keys this project publishes at
# <url>/auth/v1/.well-known/jwks.json. There is no shared secret to leak.
SUPABASE_URL=https://your-project-ref.supabase.co

# Photos (§9). Leave blank and the photo endpoints return a clear 503 while
# the rest of the app works normally.
#
# Create the bucket in the Supabase dashboard: Storage -> New bucket, named
# `photos`, with "Public bucket" OFF. The app never reaches it directly; the
# API mints short-lived signed URLs for each upload and view.
SUPABASE_STORAGE_BUCKET=
#
# Settings -> API Keys -> `service_role`. SERVER ONLY — this key bypasses row
# level security. It must never appear in app/.env or anywhere the device can
# read it.
SUPABASE_SERVICE_KEY=

# Comma-separated browser origins allowed to call this API.
#
# REQUIRED in production, e.g. https://gym.example.com — without it the API
# falls back to allowing localhost and private-LAN origins only, which is
# right for development and useless once deployed.
#
# The app runs in a browser, so every request is subject to CORS. This is
# the difference between the site working and every call failing with
# "could not reach the server".
ALLOWED_ORIGINS=
